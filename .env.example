# Copy to .env.local (gitignored) and fill in your Firebase web app config.
# The same JSON goes into the GitHub repository secret FIREBASE_CONFIG.
VITE_FIREBASE_CONFIG={"apiKey":"YOUR_API_KEY","authDomain":"YOUR_PROJECT.firebaseapp.com","projectId":"YOUR_PROJECT","storageBucket":"YOUR_PROJECT.firebasestorage.app","messagingSenderId":"000000000000","appId":"1:000000000000:web:0000000000000000000000","databaseURL":"https://YOUR_PROJECT-default-rtdb.REGION.firebasedatabase.app"}
